{
  "_comment": "Paper figure registry. Two layers: tools = viz programs (HTML viewer + capture CLI + tool-wide defaults); figures = named instances of a tool with parameter overrides. Paths in this file are project-root-relative; fig.py / fig-web.html resolve them.",
  "tools": {
    "tree_viz": {
      "cli": "extras/figures/capture_tree_viz.py",
      "web": "figures/tree_viz.html",
      "defaults": {
        "splitting":     0,
        "fold-subtrees": 0,
        "no-overlap":    1,
        "show-skew":     0
      }
    },
    "plot_viz": {
      "_comment": "LATER"
    }
  },
  "figures": [
    {
      "name": "flattree-canon",
      "tool": "tree_viz",
      "params": {
        "text":         "coconut papaya",
        "ph-opt":       "0",
        "show-flat":    "0",
        "title":        "coconut papaya — canonical",
        "labels":       "ops/byte"
      }
    },
    {
      "name": "flattree-flat",
      "tool": "tree_viz",
      "params": {
        "text":         "coconut papaya",
        "ph-opt":       0,
        "show-flat":    1,
        "title":        "coconut papaya — flat subtrees",
        "labels":       "ops/byte"
      }
    },
    {
      "name": "flattree-opt",
      "tool": "tree_viz",
      "params": {
        "text":         "coconut papaya",
        "ph-opt":       1,
        "show-flat":    1,
        "title":        "coconut papaya — optimized subtrees",
        "labels":       "ops/byte"
      }
    },
    {
      "name": "pivot-bitmaps",
      "tool": "tree_viz",
      "params": {
        "title": "Pivoting \"huffman\"",
        "text": "huffman",
        "view": "pivot"
      }
    },
    {
      "name": "pivot-tree",
      "tool": "tree_viz",
      "params": {
        "title": "Pivoted \"huffman\" tree",
        "text": "huffman",
        "ph-opt": 0,
        "show-flat": 0,
        "fuse-leaves": 0,
        "constant": 0,
        "leaf-details": 1,
        "show-bitmaps": 1
      }
    }
  ]
}
