  title     = {Arithmetic coding for data compression},
  journal   = {Communications of the ACM},
  volume    = {30},
  number    = {6},
  pages     = {520--540},
  year      = {1987},
  doi       = {10.1145/214762.214771},
  note      = {The canonical practical arithmetic-coding paper —
              "the WNC paper".  Lays out the integer-arithmetic
              renormalisation scheme everything since uses
              (range/CABAC/MQ are direct descendants).  Cited as
              the entropy-coding gold standard (within ε of binary
              entropy) but with the fatal-for-ph property that
