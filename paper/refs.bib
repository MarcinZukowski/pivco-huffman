% PIVCO-Huffman bibliography (BibTeX).
%
% Organised by topic.  Each entry has a `note = {...}` field that
% explains *why* it's relevant to this project — what idea / data
% point / negative result it contributed.  This is the working
% reading-list for the paper draft; cite into the manuscript via
% `@key` (Typst Hayagriva accepts BibTeX directly via
% `#bibliography("refs.bib")`).
%
% Conventions:
%   - citekeys: firstauthor + 4-digit year + suffix-if-needed.
%   - URLs preferred over DOIs when both exist (DOIs often paywalled).
%   - `% [USED FOR: ...]` lines mark project artefacts that drew on
%     the source directly (a doc, an idea, a benchmark, a kernel).

% ============================================================
%  1. Foundational Huffman coding
% ============================================================

@article{huff,
  author    = {Huffman, David A.},
  title     = {A Method for the Construction of Minimum-Redundancy Codes},
  journal   = {Proceedings of the IRE},
  volume    = {40},
  number    = {9},
  pages     = {1098--1101},
  year      = {1952},
  doi       = {10.1109/JRPROC.1952.273898},
  note      = {The original paper.  Every Huffman codec — including
              ph — descends from this.}
}

@article{schwartz1964canonical,
  author    = {Schwartz, Eugene S. and Kallick, Bruce},
  title     = {Generating a canonical prefix encoding},
  journal   = {Communications of the ACM},
  volume    = {7},
  number    = {3},
  pages     = {166--169},
  year      = {1964},
  doi       = {10.1145/363958.363991},
  note      = {Canonical-code assignment — same code lengths, codes
              numbered in (length asc, symbol asc) order.  ph's
              "byte asc" within-tier ordering reproduces exactly
              this; "freq desc" is the ph-flat-aware deviation.}
}

@article{moffat,
  author    = {Moffat, Alistair and Turpin, Andrew},
  title     = {On the Implementation of Minimum Redundancy Prefix
              Codes},
  journal   = {IEEE Transactions on Communications},
  volume    = {45},
  number    = {10},
  pages     = {1200--1207},
  year      = {1997},
  doi       = {10.1109/26.634683},
  note      = {Foundational practical-Huffman paper.  Lays out
              canonical-code construction, table-driven decoding,
              the (length asc, symbol asc) ordering, and the
              first-code-per-length / base-offset arrays every
              modern Huffman decoder still uses.  Predates SIMD
              and predates the multi-stream ILP trick (huf0)
              by decades but is the conceptual baseline ph
              measures against.}
}

