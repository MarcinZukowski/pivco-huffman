diff -urN '--exclude=build' '--exclude=.git*' '--exclude=ext' '--exclude=*.pvh' '--exclude=*.dSYM' '--exclude=.DS_Store' '--exclude=phaz' e1stage/src/pivco_ctx.c pr30tree/src/pivco_ctx.c
--- e1stage/src/pivco_ctx.c	1969-12-31 16:00:00.000000000 -0800
+++ pr30tree/src/pivco_ctx.c	2026-08-24 11:31:56.067325003 -0700
@@ -0,0 +1,621 @@
+/* Static context-model coders, tANS implementation.  See pivco_ctx.h.
+ *
+ * Both coders (binary order-k over bits, 4-ary order-q over route
+ * pairs) are realized by ONE mechanism: an order-c carry-indexed tANS
+ * over BYTES, c = k or 2q context bits.  A bitmap's payload is coded
+ * byte-at-a-time; the fused route stream is packed 4 pairs/byte first
+ * (tail pairs raw).  The per-carry distribution over the 256 byte
+ * values is derived by the chain rule from the transmitted per-context
+ * probabilities, so the wire params are unchanged from the rANS
+ * prototype; only the payload encoding differs.
+ *
+ * Decode hot loop: e = D[carry][state]; emit e.sym (8 bits);
+ * carry = e.sym >> (8-c); state = e.base + readBits(e.nbBits).
+ *
+ * Tables are expanded per parameter set (2^c tables x 2^L states) and
+ * cached process-wide keyed by (mode, params); typical streams reuse a
+ * handful of parameter sets, so builds amortize.
+ *
+ * Bit stream: encoder walks symbols backward pushing bits LSB-first
+ * forward; a terminator 1-bit marks the end; the decoder locates it
+ * and reads the bit string backward by absolute position. */
+
+#include "pivco_ctx.h"
+
+#include <math.h>
+#include <time.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CTX_L        11              /* max; 16-param modes use 10 */
+#define CTX_TSIZE    (1 << CTX_L)
+
+/* Per-mode state-space size: the 16-param modes (bin k=4, quad q=2)
+ * build 16 carry tables per set, so they get a half-size table --
+ * halves build cost, negligible ratio cost at a 256-value alphabet. */
+static int mode_L(int mode)
+{
+    return (mode == PIVCO_CTX4_ID || mode == PIVCO_QUAD_CTX2_ID) ? 10 : 11;
+}
+
+/* ---- probability grids (wire format; must not change) ---- */
+static const uint16_t PTAB[16] = {
+      64,  128,  256,  512,  768, 1024, 1536, 2048,
+    2560, 3072, 3328, 3584, 3840, 3968, 4032, 4064,
+};
+static const uint16_t WTAB[16] = {
+    1, 2, 3, 4, 6, 8, 12, 16, 24, 32, 48, 64, 96, 128, 192, 256,
+};
+
+/* ---- model expansion: per-(carry, byte) probability ---- */
+
+/* Binary order-k: p1[ctx] = P(bit=1 | last k bits), k in {2,4}. */
+static void bin_byte_probs(int k, const uint8_t *pidx,
+                           int carry, double out[256])
+{
+    int nctx = 1 << k;
+    uint32_t cmask = (uint32_t)nctx - 1;
+    for (int v = 0; v < 256; v++) {
+        double pr = 1.0;
+        uint32_t c = (uint32_t)carry;
+        for (int j = 0; j < 8; j++) {
+            int bit = (v >> j) & 1;
+            double p1 = (double)PTAB[pidx[c]] / 4096.0;
+            pr *= bit ? p1 : 1.0 - p1;
+            c = ((c << 1) | (uint32_t)bit) & cmask;
+        }
+        out[v] = pr;
+    }
+}
+
+/* 4-ary order-q: per-context 4-way weights, q in {1,2}; a byte holds
+ * 4 pairs (LSB-first). */
+static void quad_byte_probs(int q, const uint8_t widx[][4],
+                            int carry, double out[256])
+{
+    int nctx = 1 << (2 * q);
+    uint32_t cmask = (uint32_t)nctx - 1;
+    for (int v = 0; v < 256; v++) {
+        double pr = 1.0;
+        uint32_t c = (uint32_t)carry;
+        for (int j = 0; j < 4; j++) {
+            int s = (v >> (2 * j)) & 3;
+            uint32_t w[4], sum = 0;
+            for (int t = 0; t < 4; t++) { w[t] = WTAB[widx[c][t] & 15]; sum += w[t]; }
+            pr *= (double)w[s] / (double)sum;
+            c = ((c << 2) | (uint32_t)s) & cmask;
+        }
+        out[v] = pr;
+    }
+}
+
+/* ---- tANS table build (per carry) ---- */
+
+/* Alphabet is 257: byte values 0..255 plus ESC (256).  Bytes whose
+ * model probability rounds to zero slots are coded as ESC followed by
+ * the raw byte (8 bits); their aggregated mass prices ESC. */
+#define CTX_ESC 256
+
+typedef struct { uint16_t base; uint16_t sym; uint8_t nbBits; } dent_t;
+typedef struct { uint32_t deltaNbBits; int32_t deltaFindState; } stt_t;
+
+typedef struct {
+    dent_t d[CTX_TSIZE];       /* decode entries */
+    stt_t  tt[257];            /* encode per-symbol transform */
+    uint16_t st[CTX_TSIZE];    /* encode state table */
+} ctab_t;
+
+static int highbit(uint32_t v) { return 31 - __builtin_clz(v); }
+
+/* Normalize probs to freqs summing 2^L.  Zero frequencies are ALLOWED
+ * (a byte value the model considers negligible gets no slot); the
+ * encoder rejects the whole candidate if such a byte actually occurs,
+ * and commit-if-smaller falls back.  Forcing every value >= 1 was
+ * measured to tax skewed tables up to ~12% (256/2048 of the mass).
+ * Deterministic: floor + largest-remainder, ties by symbol index. */
+static void normalize(const double p[256], uint16_t f[257], int tsize)
+{
+    double sum = 0;
+    for (int v = 0; v < 256; v++) sum += p[v];
+    int32_t used = 0;
+    double rem[257];
+    double esc = 0;
+    for (int v = 0; v < 256; v++) {
+        double share = p[v] / sum * (double)(tsize - 1);
+        uint32_t fs = (uint32_t)share;
+        if (fs == 0) { f[v] = 0; rem[v] = -3.0; esc += share; continue; }
+        f[v] = (uint16_t)fs;
+        rem[v] = share - (double)fs;
+        used += (int32_t)fs;
+    }
+    f[CTX_ESC] = (uint16_t)(1 + (uint32_t)esc);   /* >= 1 always */
+    rem[CTX_ESC] = esc - (double)(uint32_t)esc;
+    used += (int32_t)f[CTX_ESC];
+    int32_t left = (int32_t)tsize - used;
+    /* leftover goes to the largest-frequency symbol (FSE's fast-path
+     * policy): O(256), and the entropy distortion is negligible since
+     * the largest bucket dominates whenever leftover is sizable */
+    int big = CTX_ESC;
+    for (int v = 0; v < 256; v++)
+        if (f[v] > f[big]) big = v;
+    f[big] = (uint16_t)(f[big] + left);
+    (void)rem;
+}
+
+static void build_ctab(const double p[256], ctab_t *t, int L,
+                       int want_enc, int want_dec)
+{
+    int tsize = 1 << L;
+    uint16_t f[257];
+    normalize(p, f, tsize);
+
+    /* spread (FSE-style) */
+    static uint16_t tsym[CTX_TSIZE];
+    {
+        uint32_t step = ((uint32_t)tsize >> 1) + ((uint32_t)tsize >> 3) + 3;
+        uint32_t pos = 0;
+        for (int s = 0; s <= 256; s++)
+            for (int i = 0; i < f[s]; i++) {
+                tsym[pos] = (uint16_t)s;
+                pos = (pos + step) & ((uint32_t)tsize - 1);
+            }
+    }
+
+    /* decode entries */
+    if (want_dec) {
+        uint16_t next[257];
+        memcpy(next, f, sizeof(next));
+        for (int x = 0; x < tsize; x++) {
+            int s = tsym[x];
+            uint32_t X = next[s]++;
+            int nb = L - highbit(X);
+            t->d[x].sym    = (uint16_t)s;
+            t->d[x].nbBits = (uint8_t)nb;
+            t->d[x].base   = (uint16_t)((X << nb) - (uint32_t)tsize);
+        }
+    }
+
+    /* encode tables */
+    if (want_enc) {
+        uint32_t cumul = 0;
+        for (int s = 0; s <= 256; s++) {
+            if (f[s] == 0) {               /* coded via ESC instead */
+                t->tt[s].deltaNbBits = 0xFFFFFFFFu;   /* sentinel */
+                t->tt[s].deltaFindState = 0;
+                continue;
+            }
+            int maxBits = L - highbit((uint32_t)f[s] == 1 ? 1 : (uint32_t)f[s] - 1);
+            if (f[s] == 1) maxBits = L;        /* freq-1: always flush L bits */
+            t->tt[s].deltaNbBits    = ((uint32_t)maxBits << 16) - ((uint32_t)f[s] << maxBits);
+            t->tt[s].deltaFindState = (int32_t)cumul - (int32_t)f[s];
+            cumul += f[s];
+        }
+        uint16_t fill[257];
+        fill[0] = 0;
+        for (int s = 0; s < 256; s++) fill[s + 1] = (uint16_t)(fill[s] + f[s]);
+        for (int x = 0; x < tsize; x++) {
+            int s = tsym[x];
+            t->st[fill[s]++] = (uint16_t)((uint32_t)tsize + x);
+        }
+    }
+}
+
+/* ---- table cache (process-wide, single-threaded use) ---- */
+
+#define CACHE_WAYS 512
+typedef struct {
+    int      valid;
+    int      mode;             /* wire id */
+    int      has_enc, has_dec;
+    uint8_t  params[32];
+    size_t   plen;
+    int      nc;               /* number of carries = 2^c */
+    ctab_t  *tabs;             /* nc tables */
+    uint64_t stamp;
+} centry_t;
+static centry_t g_cache[CACHE_WAYS];
+static uint64_t g_stamp;
+uint64_t pivco_ctx_cache_hits, pivco_ctx_cache_misses;
+uint64_t pivco_ctx_ns_build, pivco_ctx_ns_dec;
+static uint64_t now_ns(void) {
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static const ctab_t *cache_get(int mode, const uint8_t *params, size_t plen,
+                               int want_enc, int want_dec)
+{
+    for (int i = 0; i < CACHE_WAYS; i++) {
+        centry_t *e = &g_cache[i];
+        if (e->valid && e->mode == mode && e->plen == plen &&
+            memcmp(e->params, params, plen) == 0) {
+            if ((want_enc && !e->has_enc) || (want_dec && !e->has_dec))
+                continue;   /* other half only; fall through to a rebuild */
+            e->stamp = ++g_stamp;
+            pivco_ctx_cache_hits++;
+            return e->tabs;
+        }
+    }
+    /* miss: evict LRU */
+    pivco_ctx_cache_misses++;
+    uint64_t t0 = now_ns();
+    int victim = 0;
+    for (int i = 1; i < CACHE_WAYS; i++)
+        if (!g_cache[i].valid ||
+            (g_cache[victim].valid && g_cache[i].stamp < g_cache[victim].stamp))
+            victim = i;
+    centry_t *e = &g_cache[victim];
+    int cbits = (mode == PIVCO_CTX2_ID) ? 2 :
+                (mode == PIVCO_CTX4_ID) ? 4 :
+                (mode == PIVCO_QUAD_CTX1_ID) ? 2 : 4;
+    int nc = 1 << cbits;
+    if (!e->tabs || e->nc < nc) {
+        free(e->tabs);
+        e->tabs = (ctab_t *)malloc(sizeof(ctab_t) * (size_t)nc);
+        if (!e->tabs) { e->valid = 0; return NULL; }
+    }
+    e->valid = 1; e->mode = mode; e->plen = plen; e->nc = nc;
+    e->has_enc = want_enc; e->has_dec = want_dec;
+    memcpy(e->params, params, plen);
+    e->stamp = ++g_stamp;
+
+    double probs[256];
+    if (mode == PIVCO_CTX2_ID || mode == PIVCO_CTX4_ID) {
+        int k = (mode == PIVCO_CTX2_ID) ? 2 : 4;
+        uint8_t pidx[16];
+        for (size_t i = 0; i < plen; i++) {
+            pidx[2 * i]     = (uint8_t)(params[i] & 0x0F);
+            pidx[2 * i + 1] = (uint8_t)(params[i] >> 4);
+        }
+        for (int c = 0; c < nc; c++) {
+            bin_byte_probs(k, pidx, c, probs);
+            build_ctab(probs, &e->tabs[c], mode_L(mode), want_enc, want_dec);
+        }
+    } else {
+        int q = (mode == PIVCO_QUAD_CTX1_ID) ? 1 : 2;
+        uint8_t widx[16][4];
+        int nctx = 1 << (2 * q);
+        for (int c = 0; c < nctx; c++) {
+            widx[c][0] = (uint8_t)(params[2 * c] & 0x0F);
+            widx[c][1] = (uint8_t)(params[2 * c] >> 4);
+            widx[c][2] = (uint8_t)(params[2 * c + 1] & 0x0F);
+            widx[c][3] = (uint8_t)(params[2 * c + 1] >> 4);
+        }
+        for (int c = 0; c < nc; c++) {
+            quad_byte_probs(q, widx, c, probs);
+            build_ctab(probs, &e->tabs[c], mode_L(mode), want_enc, want_dec);
+        }
+    }
+    pivco_ctx_ns_build += now_ns() - t0;
+    return e->tabs;
+}
+
+/* ---- bit IO ----
+ * Encoder: LSB-first pushes, bytes appended forward.
+ * Decoder: reads the bit string backward by absolute position. */
+
+typedef struct { uint64_t acc; int cnt; uint8_t *p, *end; } bw_t;
+
+static int bw_push(bw_t *w, uint32_t v, int n)
+{
+    w->acc |= (uint64_t)v << w->cnt;
+    w->cnt += n;
+    while (w->cnt >= 8) {
+        if (w->p >= w->end) return -1;
+        *w->p++ = (uint8_t)(w->acc & 0xFF);
+        w->acc >>= 8;
+        w->cnt -= 8;
+    }
+    return 0;
+}
+
+static inline uint32_t br_read(const uint8_t *base, size_t *bitpos, int n)
+{
+    *bitpos -= (size_t)n;
+    uint64_t win;
+    memcpy(&win, base + (*bitpos >> 3), 8);
+    return (uint32_t)(win >> (*bitpos & 7)) & ((1u << n) - 1u);
+}
+
+/* Encoder-side param snapping: if a cached parameter set of the same
+ * mode is within +-1 of every 4-bit param, adopt it (it goes on the
+ * wire verbatim), so later nodes converge onto already-built tables
+ * and the decoder's cache hits.  The model shift is at most one grid
+ * step per context, and commit-if-smaller still prices the result. */
+/* Max distinct param sets per mode (per process): the ratio/decode-
+ * speed dial.  Every distinct set costs one table build on each side;
+ * PIVCO_CTX_DICT overrides (prototype knob). */
+static int dict_cap(void)
+{
+    static int cap = -1;
+    if (cap < 0) {
+        const char *e = getenv("PIVCO_CTX_DICT");
+        cap = e ? atoi(e) : 48;
+        if (cap < 1) cap = 1;
+        if (cap > CACHE_WAYS / 4) cap = CACHE_WAYS / 4;
+    }
+    return cap;
+}
+static void cache_snap(int mode, uint8_t *params, size_t plen)
+{
+    /* PIVCO_CTX_FREE: analysis knob — no dictionary, every node keeps
+     * its own params (the pre-cap coder; encoder-side only). */
+    static int free_mode = -1;
+    if (free_mode < 0) free_mode = getenv("PIVCO_CTX_FREE") != NULL;
+    if (free_mode) return;
+    /* pass 1: exact-or-close (+-1 every nibble) adoption */
+    int count = 0;
+    for (int i = 0; i < CACHE_WAYS; i++) {
+        centry_t *e = &g_cache[i];
+        if (!e->valid || e->mode != mode || e->plen != plen) continue;
+        count++;
+        int ok = 1;
+        for (size_t b = 0; b < plen && ok; b++) {
+            int lo_a = params[b] & 0x0F,  lo_b = e->params[b] & 0x0F;
+            int hi_a = params[b] >> 4,    hi_b = e->params[b] >> 4;
+            if (lo_a - lo_b > 1 || lo_b - lo_a > 1 ||
+                hi_a - hi_b > 1 || hi_b - hi_a > 1) ok = 0;
+        }
+        if (ok) { memcpy(params, e->params, plen); return; }
+    }
+    if (count < dict_cap()) return; /* room: keep own params, seed the dict */
+    /* dictionary full: adopt the nearest set outright.  A bad fit codes
+     * bigger and commit-if-smaller falls back to sANS/dANS/raw. */
+    int best = -1; int bd = 1 << 30;
+    for (int i = 0; i < CACHE_WAYS; i++) {
+        centry_t *e = &g_cache[i];
+        if (!e->valid || e->mode != mode || e->plen != plen) continue;
+        int d = 0;
+        for (size_t b = 0; b < plen; b++) {
+            int lo = (params[b] & 0x0F) - (e->params[b] & 0x0F);
+            int hi = (params[b] >> 4)   - (e->params[b] >> 4);
+            d += (lo < 0 ? -lo : lo) + (hi < 0 ? -hi : hi);
+        }
+        if (d < bd) { bd = d; best = i; }
+    }
+    if (best >= 0) memcpy(params, g_cache[best].params, plen);
+}
+
+/* ---- carry maps ----
+ * The rolling context keeps the NEWEST bit (or pair) in its low
+ * position, while a byte's chronologically-last bits are its HIGH
+ * bits, so carry = reversed top bits.  Consulting the tables under
+ * the raw top bits is consistent between encode and decode (round-
+ * trips fine) but silently prices with permuted context labels. */
+static const uint8_t CMAP_BIN2[4]   = { 0, 2, 1, 3 };
+static const uint8_t CMAP_BIN4[16]  = { 0, 8, 4, 12, 2, 10, 6, 14,
+                                        1, 9, 5, 13, 3, 11, 7, 15 };
+static const uint8_t CMAP_QUAD1[4]  = { 0, 1, 2, 3 };
+static const uint8_t CMAP_QUAD2[16] = { 0, 4, 8, 12, 1, 5, 9, 13,
+                                        2, 6, 10, 14, 3, 7, 11, 15 };
+
+static const uint8_t *carry_map(int mode)
+{
+    switch (mode) {
+    case PIVCO_CTX2_ID:      return CMAP_BIN2;
+    case PIVCO_CTX4_ID:      return CMAP_BIN4;
+    case PIVCO_QUAD_CTX1_ID: return CMAP_QUAD1;
+    default:                 return CMAP_QUAD2;
+    }
+}
+
+/* ---- core coder: order-c carry tANS over bytes ---- */
+
+static int ctx_encode_bytes(int mode, const uint8_t *params, size_t plen,
+                            const uint8_t *syms, size_t n, int cbits,
+                            uint8_t *dst, size_t dst_cap, size_t *out_len)
+{
+    const ctab_t *tabs = cache_get(mode, params, plen, 1, 0);
+    if (!tabs) return -1;
+    if (dst_cap < plen) return -1;
+    const uint8_t *cmap = carry_map(mode);
+    memcpy(dst, params, plen);
+    bw_t w = { 0, 0, dst + plen, dst + dst_cap };
+
+    const int L = mode_L(mode);
+    uint32_t state = 1u << L;                /* any valid start */
+    for (size_t j = n; j-- > 0; ) {
+        int carry = j ? cmap[syms[j - 1] >> (8 - cbits)] : 0;
+        const ctab_t *t = &tabs[carry];
+        int s = syms[j];
+        int is_esc = (t->tt[s].deltaNbBits == 0xFFFFFFFFu);
+        int cs = is_esc ? CTX_ESC : s;
+        uint32_t nb = (state + t->tt[cs].deltaNbBits) >> 16;
+        if (bw_push(&w, state & ((1u << nb) - 1u), (int)nb) != 0) return -1;
+        state = t->st[(state >> nb) + (uint32_t)t->tt[cs].deltaFindState];
+        if (is_esc && bw_push(&w, (uint32_t)s, 8) != 0) return -1;
+    }
+    if (bw_push(&w, state - (1u << L), L) != 0) return -1;
+    if (bw_push(&w, 1, 1) != 0) return -1;   /* terminator */
+    if (w.cnt > 0) {                          /* pad to byte */
+        if (w.p >= w.end) return -1;
+        *w.p++ = (uint8_t)(w.acc & 0xFF);
+    }
+    *out_len = (size_t)(w.p - dst);
+    return 0;
+}
+
+static int ctx_decode_bytes(int mode, const uint8_t *src, size_t src_len,
+                            size_t plen, int cbits,
+                            uint8_t *dst, size_t n)
+{
+    if (src_len < plen + 2) return -1;
+    const ctab_t *tabs = cache_get(mode, src, plen, 0, 1);
+    if (!tabs) return -1;
+
+    /* copy the payload into padded scratch: br_read does unaligned
+     * 8-byte loads that may touch up to 7 bytes below the read point */
+    const uint8_t *pl = src + plen;
+    size_t pl_len = src_len - plen;
+    uint8_t stack_buf[4096 + 16];
+    uint8_t *buf = pl_len + 16 <= sizeof(stack_buf)
+                   ? stack_buf : (uint8_t *)malloc(pl_len + 16);
+    if (!buf) return -1;
+    memset(buf, 0, 8);
+    memcpy(buf + 8, pl, pl_len);
+
+    /* locate terminator: highest set bit of last byte */
+    uint8_t last = buf[8 + pl_len - 1];
+    if (last == 0) { if (buf != stack_buf) free(buf); return -1; }
+    size_t bitpos = 8 * 8 + (pl_len - 1) * 8 + (size_t)highbit(last);
+
+    const uint8_t *cmap = carry_map(mode);
+    const int L = mode_L(mode);
+    uint64_t td = now_ns();
+    uint32_t state = br_read(buf, &bitpos, L);
+    int carry = 0;
+    for (size_t j = 0; j < n; j++) {
+        const dent_t *e = &tabs[carry].d[state];
+        uint32_t b = e->sym;
+        if (b == CTX_ESC) b = br_read(buf, &bitpos, 8);
+        dst[j] = (uint8_t)b;
+        carry = cmap[b >> (8 - cbits)];
+        state = e->base + br_read(buf, &bitpos, e->nbBits);
+    }
+    pivco_ctx_ns_dec += now_ns() - td;
+    if (buf != stack_buf) free(buf);
+    return 0;
+}
+
+/* ---- public API (signatures unchanged from the rANS prototype) ---- */
+
+int pivco_ctx_bin_compress(int order, const uint8_t *src, size_t nbytes,
+                           uint8_t *dst, size_t dst_cap, size_t *out_len)
+{
+    int nctx = 1 << order;
+    uint32_t cmask = (uint32_t)nctx - 1;
+    size_t nbits = nbytes * 8;
+    size_t params_bytes = (size_t)nctx / 2;
+
+    /* estimate + quantize (identical to the rANS prototype) */
+    uint32_t cnt[16][2];
+    memset(cnt, 0, sizeof(uint32_t) * (size_t)nctx * 2);
+    uint32_t ctx = 0;
+    for (size_t i = 0; i < nbits; i++) {
+        int b = (src[i >> 3] >> (i & 7)) & 1;
+        cnt[ctx][b]++;
+        ctx = ((ctx << 1) | (uint32_t)b) & cmask;
+    }
+    uint8_t pidx[16];
+    for (int c = 0; c < nctx; c++) {
+        double best = 0; int bi = 0;
+        for (int k = 0; k < 16; k++) {
+            double p1 = (double)PTAB[k] / 4096.0;
+            double cost = -( (double)cnt[c][1] * log2(p1) +
+                             (double)cnt[c][0] * log2(1.0 - p1) );
+            if (k == 0 || cost < best) { best = cost; bi = k; }
+        }
+        pidx[c] = (uint8_t)bi;
+    }
+    uint8_t params[8];
+    for (size_t i = 0; i < params_bytes; i++)
+        params[i] = (uint8_t)(pidx[2 * i] | (pidx[2 * i + 1] << 4));
+
+    int mode = (order == 2) ? PIVCO_CTX2_ID : PIVCO_CTX4_ID;
+    cache_snap(mode, params, params_bytes);
+    return ctx_encode_bytes(mode, params, params_bytes, src, nbytes,
+                            order, dst, dst_cap, out_len);
+}
+
+int pivco_ctx_bin_decompress(int order, const uint8_t *src, size_t src_len,
+                             uint8_t *dst, size_t nbytes)
+{
+    int mode = (order == 2) ? PIVCO_CTX2_ID : PIVCO_CTX4_ID;
+    size_t params_bytes = (size_t)(1 << order) / 2;
+    return ctx_decode_bytes(mode, src, src_len, params_bytes, order,
+                            dst, nbytes);
+}
+
+int pivco_ctx_quad_compress(int order_q, const uint8_t *syms, size_t nsyms,
+                            uint8_t *dst, size_t dst_cap, size_t *out_len)
+{
+    int nctx = 1 << (2 * order_q);
+    uint32_t cmask = (uint32_t)nctx - 1;
+    size_t params_bytes = (size_t)nctx * 2;
+
+    uint32_t cnt[16][4];
+    memset(cnt, 0, sizeof(uint32_t) * (size_t)nctx * 4);
+    uint32_t ctx = 0;
+    for (size_t i = 0; i < nsyms; i++) {
+        cnt[ctx][syms[i] & 3]++;
+        ctx = ((ctx << 2) | (uint32_t)(syms[i] & 3)) & cmask;
+    }
+    uint8_t widx[16][4];
+    for (int c = 0; c < nctx; c++) {
+        uint32_t tot = cnt[c][0] + cnt[c][1] + cnt[c][2] + cnt[c][3];
+        for (int s = 0; s < 4; s++) {
+            double target = tot ? 256.0 * ((double)cnt[c][s] + 0.5) /
+                                    ((double)tot + 2.0)
+                                : 64.0;
+            double lt = log(target);
+            int bi = 0; double bd = 0;
+            for (int k = 0; k < 16; k++) {
+                double d = fabs(log((double)WTAB[k]) - lt);
+                if (k == 0 || d < bd) { bd = d; bi = k; }
+            }
+            widx[c][s] = (uint8_t)bi;
+        }
+    }
+    uint8_t params[32];
+    for (int c = 0; c < nctx; c++) {
+        params[2 * c]     = (uint8_t)(widx[c][0] | (widx[c][1] << 4));
+        params[2 * c + 1] = (uint8_t)(widx[c][2] | (widx[c][3] << 4));
+    }
+
+    /* pack 4 pairs/byte; tail pairs go raw after the coded payload */
+    size_t nfull = nsyms / 4;
+    size_t ntail = nsyms - nfull * 4;
+    uint8_t *packed = (uint8_t *)malloc(nfull ? nfull : 1);
+    if (!packed) return -1;
+    for (size_t j = 0; j < nfull; j++)
+        packed[j] = (uint8_t)( (syms[4 * j]     & 3)
+                             | ((syms[4 * j + 1] & 3) << 2)
+                             | ((syms[4 * j + 2] & 3) << 4)
+                             | ((syms[4 * j + 3] & 3) << 6));
+
+    int mode = (order_q == 1) ? PIVCO_QUAD_CTX1_ID : PIVCO_QUAD_CTX2_ID;
+    cache_snap(mode, params, params_bytes);
+    size_t body = 0;
+    int rc = ctx_encode_bytes(mode, params, params_bytes, packed, nfull,
+                              2 * order_q, dst, dst_cap, &body);
+    free(packed);
+    if (rc != 0) return -1;
+    if (ntail) {                              /* raw tail byte */
+        if (body + 1 > dst_cap) return -1;
+        uint8_t tb = 0;
+        for (size_t i = 0; i < ntail; i++)
+            tb |= (uint8_t)((syms[nfull * 4 + i] & 3) << (2 * i));
+        dst[body++] = tb;
+    }
+    *out_len = body;
+    return 0;
+}
+
+int pivco_ctx_quad_decompress(int order_q, const uint8_t *src, size_t src_len,
+                              uint8_t *syms, size_t nsyms)
+{
+    int mode = (order_q == 1) ? PIVCO_QUAD_CTX1_ID : PIVCO_QUAD_CTX2_ID;
+    size_t params_bytes = (size_t)(1 << (2 * order_q)) * 2;
+    size_t nfull = nsyms / 4;
+    size_t ntail = nsyms - nfull * 4;
+    size_t body_len = src_len - (ntail ? 1 : 0);
+
+    uint8_t *packed = (uint8_t *)malloc(nfull ? nfull : 1);
+    if (!packed) return -1;
+    int rc = ctx_decode_bytes(mode, src, body_len, params_bytes,
+                              2 * order_q, packed, nfull);
+    if (rc != 0) { free(packed); return -1; }
+    for (size_t j = 0; j < nfull; j++) {
+        syms[4 * j]     = (uint8_t)( packed[j]       & 3);
+        syms[4 * j + 1] = (uint8_t)((packed[j] >> 2) & 3);
+        syms[4 * j + 2] = (uint8_t)((packed[j] >> 4) & 3);
+        syms[4 * j + 3] = (uint8_t)((packed[j] >> 6) & 3);
+    }
+    free(packed);
+    if (ntail) {
+        uint8_t tb = src[src_len - 1];
+        for (size_t i = 0; i < ntail; i++)
+            syms[nfull * 4 + i] = (uint8_t)((tb >> (2 * i)) & 3);
+    }
+    return 0;
+}
diff -urN '--exclude=build' '--exclude=.git*' '--exclude=ext' '--exclude=*.pvh' '--exclude=*.dSYM' '--exclude=.DS_Store' '--exclude=phaz' e1stage/src/pivco_ctx.h pr30tree/src/pivco_ctx.h
--- e1stage/src/pivco_ctx.h	1969-12-31 16:00:00.000000000 -0800
+++ pr30tree/src/pivco_ctx.h	2026-08-20 21:37:29.643259490 -0700
@@ -0,0 +1,69 @@
+/* Static context-model rANS coders for pivco-huffman's per-node records.
+ *
+ * Two coders, both "transmit quantized params, expand, code statically":
+ *
+ *   binary / order-o   P(bit | previous o bits).  2^o contexts, each a
+ *                      4-bit index into a fixed 16-entry probability
+ *                      grid.  Used on partition bitmaps and (natural-
+ *                      packed) flat regions.  Wire ids PIVCO_CTX2_ID
+ *                      (o=2) and PIVCO_CTX4_ID (o=4).
+ *
+ *   4-ary / order-q    P(pair | previous q pairs) over the fused
+ *                      parent+child route stream of a quad node.  4^q
+ *                      contexts, each four 4-bit weight indexes
+ *                      normalized to the rANS scale.  Wire ids
+ *                      PIVCO_QUAD_CTX1_ID (q=1) / PIVCO_QUAD_CTX2_ID
+ *                      (q=2); PIVCO_QUAD_RAW_ID is the packed-raw form.
+ *
+ * Payload layout (both coders):
+ *   [params][initial rANS state: u32 LE][rANS bytes in decode order]
+ * params are 2^o * 4 bits (binary) or 4^q * 16 bits (4-ary).
+ *
+ * rANS: 32-bit state, 12-bit scale (PIVCO_CTX_PSCALE), byte renorm.
+ * Encoder walks the symbols backward; decoder forward.  Bit order in
+ * byte buffers is LSB-first, matching the wire bitmaps. */
+
+#ifndef PIVCO_CTX_H
+#define PIVCO_CTX_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PIVCO_CTX_PSCALE_BITS 12
+#define PIVCO_CTX_PSCALE      (1u << PIVCO_CTX_PSCALE_BITS)
+
+/* Wire ids (extend the FSE marker id space; see pivco_fse.h). */
+#define PIVCO_CTX2_ID      52   /* binary, o=2 */
+#define PIVCO_CTX4_ID      53   /* binary, o=4 */
+#define PIVCO_QUAD_RAW_ID  54   /* fused route stream, packed raw 2 bits/elem */
+#define PIVCO_QUAD_CTX1_ID 55   /* fused, 4-ary ctx q=1 */
+#define PIVCO_QUAD_CTX2_ID 56   /* fused, 4-ary ctx q=2 */
+
+/* Binary order-o coder over src's nbytes*8 bits (LSB-first per byte).
+ * order must be 2 or 4.  Returns 0 on success and sets *out_len; -1 if
+ * the output would not fit dst_cap. */
+int pivco_ctx_bin_compress(int order, const uint8_t *src, size_t nbytes,
+                           uint8_t *dst, size_t dst_cap, size_t *out_len);
+
+/* Inverse.  Decodes exactly nbytes bytes.  Returns 0 on success, -1 on
+ * malformed input (truncated). */
+int pivco_ctx_bin_decompress(int order, const uint8_t *src, size_t src_len,
+                             uint8_t *dst, size_t nbytes);
+
+/* 4-ary order-q coder over nsyms 2-bit symbols, given unpacked one
+ * symbol per byte (values 0..3).  order_q must be 1 or 2. */
+int pivco_ctx_quad_compress(int order_q, const uint8_t *syms, size_t nsyms,
+                            uint8_t *dst, size_t dst_cap, size_t *out_len);
+
+int pivco_ctx_quad_decompress(int order_q, const uint8_t *src, size_t src_len,
+                              uint8_t *syms, size_t nsyms);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PIVCO_CTX_H */
