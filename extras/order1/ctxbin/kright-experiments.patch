+/* Experiment: no K_right on the wire.  Each node's bitmap goes ahead of
+ * its children's regions and the decoder popcounts it for K_right. */
+#ifndef PIVCO_WIRE_KR_POPCOUNT
+#define PIVCO_WIRE_KR_POPCOUNT 0
+#endif
+/* Experiment: one bit-packed block prefix carries, per region in walk
+ * order, the FSE flag (+ marker byte), the bits of the region's last
+ * partial byte, and the node's K_right in ceil(log2(n+1)) bits.  Regions
+ * then hold whole bytes only; the merges run on those and the codec
+ * finishes the <8 tail symbols from the prefix. */
+#ifndef PIVCO_WIRE_PACKED_HDR
+#define PIVCO_WIRE_PACKED_HDR 0
+#endif
+#if PIVCO_WIRE_PACKED_HDR && PIVCO_WIRE_KR_POPCOUNT
+#error "PIVCO_WIRE_PACKED_HDR and PIVCO_WIRE_KR_POPCOUNT are exclusive"
+#endif
+#if PIVCO_WIRE_PACKED_HDR
+/* Sub-experiment: PIVCO_WIRE_PACKED_TAILS=0 keeps regions byte-rounded and
+ * carries only the flag and K_right in the prefix. */
+#ifndef PIVCO_WIRE_PACKED_TAILS
+#define PIVCO_WIRE_PACKED_TAILS 1
+#endif
+#if PIVCO_WIRE_PACKED_TAILS
+#define PK_TAIL_BITS(bits) ((bits) & 7)
+#else
+#define PK_TAIL_BITS(bits) 0
+#endif
+#define META_PARAMS , uint8_t *node_tail, int *node_kr
+#define META_ARGS   , node_tail, node_kr
+#define DEC_PARAMS  , br_t *br
+#define DEC_ARGS    , br
+#define BLOCK_CONSUMED (in_len)
+
+typedef struct { uint8_t *p; uint64_t acc; int nb; } bw_t;
+static inline void bw_put(bw_t *w, uint32_t v, int bits)
+{
+    w->acc |= (uint64_t)v << w->nb;
+    w->nb += bits;
+    while (w->nb >= 8) {
+        *w->p++ = (uint8_t)w->acc;
+        w->acc >>= 8;
+        w->nb -= 8;
+    }
+}
+static inline uint8_t *bw_flush(bw_t *w)
+{
+    if (w->nb) *w->p++ = (uint8_t)w->acc;
+    return w->p;
+}
+/* The prefix sits at the block's end, byte-reversed, so the decoder
+ * reads it backwards from in + in_len and needs no length field.  One
+ * refill per node tops the accumulator up to 56..63 bits with a single
+ * 8-byte load (byte loop only within 8 bytes of the block start). */
+typedef struct { const uint8_t *p; const uint8_t *lo; uint64_t acc; int nb; } br_t;
+static inline void br_refill(br_t *r)
+{
+    if (r->p - 8 >= r->lo) {
+        uint64_t w;
+        memcpy(&w, r->p - 8, 8);
+        w = __builtin_bswap64(w);
+        r->acc |= w << r->nb;
+        r->p -= (63 - r->nb) >> 3;
+        r->nb |= 56;
+    } else {
+        while (r->nb <= 56 && r->p > r->lo) {
+            r->acc |= (uint64_t)*(--r->p) << r->nb;
+            r->nb += 8;
+        }
+    }
+}
+static inline uint32_t br_take(br_t *r, int bits)
+{
+    uint32_t v = (uint32_t)(r->acc & ((1ull << bits) - 1));
+    r->acc >>= bits;
+    r->nb -= bits;
+    return v;
+}
+/* Bits for a value in [0, n]. */
+static inline int bits_for(int n) { return n ? 32 - __builtin_clz((unsigned)n) : 0; }
+
+/* The prefix, in the walk's order (larger child first, like the regions). */
+static void packed_write_rec(bw_t *w, const pivco_table_t *t, int rec, int K,
+                             const uint8_t *mk, const uint8_t *tail, const int *kr)
+{
+    if (K == 0) return;
+    const pivco_sched_rec_t *r = &t->dec.sched[rec];
+    int kind = pivco_sched_kind(r);
+    int bits = (kind == PIVCO_SCHED_FLAT) ? K * pivco_sched_flat_depth(r) : K;
+    int has_kr = kind == PIVCO_SCHED_FULL || kind == PIVCO_SCHED_LEAF_LEFT;
+    int K_right = has_kr ? kr[rec] : 0;
+    /* One field the decoder fetches at once: flag, tail bits (zero for an
+     * FSE region), K_right; then the marker byte only when flagged. */
+    uint32_t v = (uint32_t)(mk[rec] != 0) | ((uint32_t)tail[rec] << 1)
+               | ((uint32_t)K_right << (1 + PK_TAIL_BITS(bits)));
+    bw_put(w, v, 1 + PK_TAIL_BITS(bits) + (has_kr ? bits_for(K) : 0));
+    if (mk[rec]) bw_put(w, mk[rec], 8);
+    if (!has_kr) return;
+    if (kind == PIVCO_SCHED_LEAF_LEFT) {
+        packed_write_rec(w, t, rec + 1, K_right, mk, tail, kr);
+        return;
+    }
+    int K_left = K - K_right;
+    int left = rec + 1;
+    int right = rec + r->right;
+    if (K_right > K_left) {
+        packed_write_rec(w, t, right, K_right, mk, tail, kr);
+        packed_write_rec(w, t, left,  K_left,  mk, tail, kr);
+    } else {
+        packed_write_rec(w, t, left,  K_left,  mk, tail, kr);
+        packed_write_rec(w, t, right, K_right, mk, tail, kr);
+    }
+}
+static size_t write_packed_prefix(uint8_t *out, const pivco_table_t *t, int N,
+                                  const uint8_t *mk, const uint8_t *tail, const int *kr)
+{
+    bw_t w = { out, 0, 0 };
+    packed_write_rec(&w, t, 0, N, mk, tail, kr);
+    return (size_t)(bw_flush(&w) - out);
+}
+/* A node's fields, read where the walk enters it. */
+static inline void packed_read_node(br_t *r, int kind, int K, int D,
+                                    uint8_t *marker, uint8_t *tail, int *K_right)
+{
+    int bits = (kind == PIVCO_SCHED_FLAT) ? K * D : K;
+    int t = PK_TAIL_BITS(bits);
+    int kb = (kind == PIVCO_SCHED_FULL || kind == PIVCO_SCHED_LEAF_LEFT) ? bits_for(K) : 0;
+    br_refill(r);
+    uint32_t v = br_take(r, 1 + t + kb);
+    *tail = (uint8_t)((v >> 1) & ((1u << t) - 1));
+    int kr = (int)(v >> (1 + t));
+    *K_right = kr > K ? K : kr;   /* corrupt stream: stay in bounds */
+    *marker = 0;
+    if (v & 1) {
+        br_refill(r);
+        *marker = (uint8_t)br_take(r, 8);
+    }
+}
+
+/* Raw regions: whole bytes from the stream, the merge runs on Kp = K & ~7
+ * symbols and the tail helpers finish the rest from the prefix bits.  FSE
+ * regions decode in full into scratch as before. */
+static inline const uint8_t *packed_read_bitmap(const uint8_t **in_ptr, int n,
+                                                uint8_t *scratch, uint8_t marker, int *kp)
+{
+    if (marker == 0) {
+        const uint8_t *bm = *in_ptr;
+#if PIVCO_WIRE_PACKED_TAILS
+        *in_ptr += n >> 3;
+        *kp = n & ~7;
+#else
+        *in_ptr += (n + 7) >> 3;
+        *kp = n;
+#endif
+        return bm;
+    }
+    *kp = n;
+    return wire_read_bitmap(in_ptr, n, scratch, marker);
+}
+static inline void tail_cst_cst(uint8_t *out, int Kp, int K, uint8_t tail,
+                                uint8_t ls, uint8_t rs)
+{
+    for (int j = Kp; j < K; j++) out[j] = ((tail >> (j - Kp)) & 1) ? rs : ls;
+}
+static inline void tail_cst_vec(uint8_t *out, int Kp, int K, uint8_t tail,
+                                uint8_t ls, const uint8_t *right, int K_right)
+{
+    int rc = K_right - __builtin_popcount(tail);
+    for (int j = Kp; j < K; j++) out[j] = ((tail >> (j - Kp)) & 1) ? right[rc++] : ls;
+}
+static inline void tail_vec_vec(uint8_t *out, int Kp, int K, uint8_t tail,
+                                const uint8_t *left, const uint8_t *right, int K_right)
+{
+    int ones = __builtin_popcount(tail);
+    int rc = K_right - ones;
+    int lc = (K - K_right) - ((K - Kp) - ones);
+    for (int j = Kp; j < K; j++) out[j] = ((tail >> (j - Kp)) & 1) ? right[rc++] : left[lc++];
+}
+/* A flat region: FSE form as before (natural-packed, full); raw form as
+ * whole bytes, the vertical spans (byte-exact by construction) through
+ * prim_merge_flat, the natural remainder's whole-byte symbols through
+ * prim_merge_flat_natural and its last symbols from the prefix tail. */
+static void packed_flat_decode(uint8_t *out, int K, int D, const uint8_t *c2s,
+                               int layout, const uint8_t **in_ptr,
+                               uint8_t marker, uint8_t tail)
+{
+    int total_bits = K * D;
+    if (marker) {
+        int nbytes = (total_bits + 7) >> 3;
+        uint16_t fse_len;
+        memcpy(&fse_len, *in_ptr, 2);
+        *in_ptr += 2;
+#ifdef PIVCO_HAS_FSE
+        uint8_t *buf = (uint8_t *)malloc((size_t)nbytes + PIVCO_FLAT_FSE_SLACK);
+        if (!buf) { *in_ptr += fse_len; return; }
+        memset(buf + nbytes, 0, PIVCO_FLAT_FSE_SLACK);
+        size_t out_len = 0;
+        (void)pivco_fse_decompress(marker & 0x7F, *in_ptr, fse_len,
+                                    buf, (size_t)nbytes, (size_t)nbytes, &out_len);
+        *in_ptr += fse_len;
+        prim_merge_flat_natural(out, K, buf, D, c2s);
+        free(buf);
+#else
+        *in_ptr += fse_len;
+#endif
+        return;
+    }
+    const uint8_t *bm = *in_ptr;
+#if !PIVCO_WIRE_PACKED_TAILS
+    *in_ptr += (total_bits + 7) >> 3;
+    prim_merge_flat(out, K, bm, D, c2s, layout);
+    (void)tail;
+    return;
+#endif
+    *in_ptr += total_bits >> 3;
+    int n5 = layout == PIVCO_FLAT_VERTICAL ? pivco_vert_n512(K, D) : 0;
+    int nv = layout != PIVCO_FLAT_NATURAL ? pivco_vert_n(K - n5, D) : 0;
+    int nvert = n5 + nv;
+    if (nvert) prim_merge_flat(out, nvert, bm, D, c2s, layout);
+    int nat = K - nvert;
+    const uint8_t *bm1 = bm + (((size_t)nvert * D) >> 3);
+    int whole = (nat * D) & ~7;        /* bits inside whole bytes */
+    int nfull = whole / D;             /* symbols entirely inside them */
+    if (nfull) prim_merge_flat_natural(out + nvert, nfull, bm1, D, c2s);
+    int pos = nfull * D;
+    uint64_t v = 0;
+    int nb = (whole >> 3) - (pos >> 3);
+    if (nb > 0) memcpy(&v, bm1 + (pos >> 3), (size_t)nb);
+    v >>= (pos & 7);
+    v |= (uint64_t)tail << (whole - pos);
+    for (int s = nfull; s < nat; s++, v >>= D) out[nvert + s] = c2s[v & ((1u << D) - 1)];
+}
+#else
+#define META_PARAMS
+#define META_ARGS
+#define DEC_PARAMS
+#define DEC_ARGS
+#define BLOCK_CONSUMED ((size_t)(ptr - in))
+#endif
+
+#if PIVCO_WIRE_KR_POPCOUNT
+/* Ones among the first n bits of bm (LSB-first): the node's K_right. */
+static inline int bitmap_popcount(const uint8_t *bm, int n)
+{
+    int cnt = 0;
+    int full = n >> 6;
+    for (int i = 0; i < full; i++) {
+        uint64_t w;
+        memcpy(&w, bm + 8 * i, 8);
+        cnt += __builtin_popcountll(w);
+    }
+    int rest = n & 63;
+    if (rest) {
+        uint64_t w = 0;
+        memcpy(&w, bm + 8 * full, (size_t)((rest + 7) >> 3));
+        w &= (1ULL << rest) - 1;
+        cnt += __builtin_popcountll(w);
+    }
+    return cnt;
+}
+#endif
 _Static_assert(PIVCO_PRIM_MERGE_OVERREAD <= PIVCO_FLAT_FSE_SLACK,
                "wire_read_flat_region's slack must cover the merges' overread");
 
