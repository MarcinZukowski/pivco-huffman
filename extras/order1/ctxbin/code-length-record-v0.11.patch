+/* CODE_LENGTHS record (see pivcohuf_file.h): LAST_SYM, MODE, then the
+ * lengths of symbols 0..LAST_SYM as MODE says.  Returns the bytes
+ * written, at most PIVCOHUF_CODE_LENGTHS_MAX. */
+static size_t write_code_lengths(const uint8_t code_len[256], uint8_t *out)
+{
+    int last = 255;
+    while (last > 0 && code_len[last] == 0) last--;
+    size_t n = (size_t)last + 1;
+    size_t nib = (n + 1) / 2;
+    out[0] = (uint8_t)last;
+    /* One length for every symbol: no payload. */
+    int same = 1;
+    for (size_t s = 1; s < n; s++) {
+        if (code_len[s] != code_len[0]) same = 0;
+    }
+    if (same) {
+        out[1] = (uint8_t)(128 + code_len[0]);
+        return 2;
+    }
+#ifdef PIVCO_HAS_FSE
+    /* FSE-coded lengths when they beat the nibbles (0 = would not fit). */
+    size_t r = FSE_compress2(out + 2, nib - 1, code_len, n, PIVCO_MAX_CODE_LEN, 6);
+    if (!FSE_isError(r) && r > 1) {
+        out[1] = (uint8_t)r;
+        return 2 + r;
+    }
+#endif
+    out[1] = 0;
+    for (size_t i = 0; i < nib; i++) {
+        uint8_t lo = code_len[2*i]     & 0x0F;
+        uint8_t hi = code_len[2*i + 1] & 0x0F;
+        out[2 + i] = (uint8_t)(lo | (hi << 4));
+    }
+    return 2 + nib;
+}
+
+size_t pivcohuf_read_code_lengths(const uint8_t *p, size_t avail,
+                                  uint8_t code_len[256])
+{
+    if (avail < 2) return 0;
+    size_t n = (size_t)p[0] + 1;
+    uint8_t mode = p[1];
+    memset(code_len, 0, 256);
+    if (mode >= 128) {
+        if (mode - 128 > PIVCO_MAX_CODE_LEN) return 0;
+        memset(code_len, mode - 128, n);
+        return 2;
+    }
+    if (mode == 0) {
+        size_t nib = (n + 1) / 2;
+        if (avail < 2 + nib) return 0;
+        for (size_t i = 0; i < nib; i++) {
+            code_len[2*i]     = p[2 + i] & 0x0F;
+            code_len[2*i + 1] = (p[2 + i] >> 4) & 0x0F;
+        }
+        if (n & 1) code_len[n] = 0;   /* the pad nibble is not a code */
+        return 2 + nib;
+    }
+#ifdef PIVCO_HAS_FSE
+    if (avail < 2 + (size_t)mode) return 0;
+    FSE_DTable dt[FSE_DTABLE_SIZE_U32(6)];
+    size_t r = FSE_decompress_wksp(code_len, n, p + 2, mode, dt, 6);
+    if (FSE_isError(r) || r != n) return 0;
+    for (size_t s = 0; s < n; s++) {
+        if (code_len[s] > PIVCO_MAX_CODE_LEN) return 0;
+    }
+    return 2 + (size_t)mode;
+#else
+    return 0;
+#endif
+}
+
+/* Pre-v0.11 CODE_LENGTHS: 128 bytes of nibbles. */
+static size_t read_nibble_lengths(const uint8_t *p, size_t avail,
+                                  uint8_t code_len[256])
+{
+    if (avail < 128) return 0;
+    for (int i = 0; i < 128; i++) {
+        code_len[2*i]     = p[i] & 0x0F;
+        code_len[2*i + 1] = (p[i] >> 4) & 0x0F;
+    }
+    return 128;
+}
