diff --git a/extras/phaz/phaz_route.h b/extras/phaz/phaz_route.h
new file mode 100644
index 0000000..fde57c8
--- /dev/null
+++ b/extras/phaz/phaz_route.h
@@ -0,0 +1,15 @@
+/* phaz: chain-free context routing fused into the sequence loop (shared by
+ * the patched zstd side and the container codec). */
+#ifndef PHAZ_ROUTE_H
+#define PHAZ_ROUTE_H
+#include <stddef.h>
+typedef struct {
+    int on, nested, B, L;
+    const unsigned char *t0, *m2, *mn;   /* stage maps */
+    const unsigned char **cur;           /* per (bin, lane) cursor */
+} phaz_route_stream;
+typedef struct { phaz_route_stream s[2]; size_t nseq; } phaz_route;
+size_t ZSTD_phazDecodeCtx(void*, size_t, const unsigned char*, const unsigned char*,
+        const unsigned char*, const unsigned char*, const unsigned char*, size_t,
+        const unsigned*, const unsigned*, const unsigned char*, size_t, const phaz_route*);
+#endif
