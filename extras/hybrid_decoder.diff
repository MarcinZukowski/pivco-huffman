--- a/pivco-huffman/include/pivco_huffman.h
+++ b/pivco-huffman/include/pivco_huffman.h
@@ -89,6 +89,8 @@
     uint8_t  flat_depth[PIVCO_MAX_TREE_NODES];
     uint16_t flat_offset[PIVCO_MAX_TREE_NODES];
     uint8_t  flat_code_to_sym[PIVCO_MAX_SYMBOLS];
+
+    uint8_t  use_traditional;   /* Heuristic: 1 if block should use traditional decoder */
 } pivco_huffman_table_t;
 
 /* ---------- Implementation selection ---------- */
diff --git a/pivco-huffman/src/huffman_table.c b/pivco-huffman/src/huffman_table.c
index 6763016..f181dd0 100644
--- a/pivco-huffman/src/huffman_table.c
+++ b/pivco-huffman/src/huffman_table.c
@@ -283,6 +283,37 @@ static void limit_code_lengths(uint8_t *lengths, int n_symbols, int max_len)
     }
 }
 
+static void compute_pivco_cost(const pivco_huffman_table_t *t, int16_t node_id, int current_cost, double *total_cost, const uint64_t *freq)
+{
+    if (node_id == t->prefill_node) {
+        return; /* cost is 0 */
+    }
+    const pivco_tree_node_t *n = &t->tree[node_id];
+    if (n->symbol >= 0) {
+        *total_cost += (double)freq[n->symbol] * current_cost;
+        return;
+    }
+    if (t->flat_depth[node_id] >= 2) {
+        uint64_t sub_freq = 0;
+        uint16_t stack[256];
+        int top = 0;
+        stack[top++] = node_id;
+        while (top > 0) {
+            int16_t curr = stack[--top];
+            if (t->tree[curr].symbol >= 0) {
+                sub_freq += freq[t->tree[curr].symbol];
+            } else {
+                stack[top++] = t->tree[curr].left;
+                stack[top++] = t->tree[curr].right;
+            }
+        }
+        *total_cost += (double)sub_freq * (current_cost + 1);
+        return;
+    }
+    compute_pivco_cost(t, n->left, current_cost + 1, total_cost, freq);
+    compute_pivco_cost(t, n->right, current_cost + 1, total_cost, freq);
+}
+
 /* ---------- Canonical Huffman code assignment ---------- */
 
 int pivco_huffman_build_table(const uint64_t freq[PIVCO_MAX_SYMBOLS],
@@ -612,16 +643,35 @@ int pivco_huffman_build_table(const uint64_t freq[PIVCO_MAX_SYMBOLS],
         }
     }
 
-    /* Flat-subtree detection.  Mark every internal node that is the root
-       of a maximal flat subtree with depth >= 2 and fill its
-       code_to_sym lookup.  The root itself is eligible — when the whole
-       tree is flat with depth >= 2, the root gets flat_depth = max_len
-       and decode_node_neon handles the whole block directly without
-       routing through pivco_huffman_decode_neon_prefix. */
+    /* Flat-subtree detection. */
     {
         uint16_t pool_cursor = 0;
         flat_mark_subtrees(table, table->tree_root, &pool_cursor);
     }
 
+    /* ---------- Hybrid Heuristic ----------
+     *
+     * Calculate expected tree-walk steps per symbol.
+     * If expected steps > 3.0, the traditional 4-stream decoder is
+     * generally faster than PIVCO tree-walk.
+     */
+    {
+        uint64_t total_freq = 0;
+        for (int i = 0; i < PIVCO_MAX_SYMBOLS; i++) total_freq += freq[i];
+
+        if (total_freq > 0) {
+            double total_cost = 0;
+            compute_pivco_cost(table, table->tree_root, 0, &total_cost, freq);
+            double avg_steps = total_cost / (double)total_freq;
+
+            if (avg_steps > 2.8) {
+                table->use_traditional = 1;
+            } else {
+                table->use_traditional = 0;
+            }
+            printf("  max_len=%d, avg_steps=%.2f, trad=%d\n", table->max_len, avg_steps, table->use_traditional);
+        }
+    }
+
     return PIVCO_OK;
 }
