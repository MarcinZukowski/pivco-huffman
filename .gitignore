build/
build-*/
# ext/ holds external clones (zstd, fse, brotli, etc.) that we don't track —
# but ext/golomb/ is our own scratch reproduction we DO track.  Exclude every
# direct child of ext/ except golomb/.  (Git won't re-include a path whose
# parent is excluded, so we can't just say `ext/` + `!ext/golomb/`.)
ext/*
!ext/golomb/
# Local build artefact of the golomb harness:
ext/golomb/golomb
*.o
*.a
*.dSYM/
.DS_Store
__pycache__/
*.pyc
# Generated by extras/bench/extract_zstd_lits — regenerable, not part of official benchmarks.
extras/datasets/lits/
